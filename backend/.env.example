# Change to "config.settings.prod" if in production
DJANGO_SETTINGS_MODULE=config.settings.dev

# Change to a real secret key
SECRET_KEY=change-me

# Production Database URL
DATABASE_URL=

# Allowed Hosts
TRUSTED_ORIGINS_DEV=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_ORIGINS_PROD=

TRUSTED_HOSTS_DEV=127.0.0.1,localhost
TRUSTED_HOSTS_PROD=

# Celery
# CELERY_BROKER_URL_DEV=redis://localhost:6379/0
# CELERY_RESULT_BACKEND_DEV=redis://localhost:6379/1

# CELERY_BROKER_URL_PROD=redis://localhost:6379/0
# CELERY_RESULT_BACKEND_PROD=redis://localhost:6379/1
